# Public app URL (no trailing slash). Used for OAuth redirects and magic links.
APP_URL=https://your-worker.example.workers.dev

# Comma-separated admin allowlists (at least one recommended).
# Example: ADMIN_EMAILS=you@bighappysmiley.com
# Example: ADMIN_GITHUB_LOGINS=your-github-login
ADMIN_EMAILS=
ADMIN_GITHUB_LOGINS=

# GitHub OAuth App
# Create at https://github.com/settings/developers
# Authorization callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# BigHappySmiley OAuth (generic OIDC/OAuth2 — wire to your IdP)
# Authorization callback URL: ${APP_URL}/api/auth/bhs/callback
BHS_OAUTH_CLIENT_ID=
BHS_OAUTH_CLIENT_SECRET=
BHS_OAUTH_AUTHORIZE_URL=
BHS_OAUTH_TOKEN_URL=
BHS_OAUTH_USERINFO_URL=
BHS_OAUTH_SCOPE=openid profile email

# Email magic link via Resend
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Suggestions <noreply@your-domain.com>"
