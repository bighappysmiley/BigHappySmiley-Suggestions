# Public app URL (no trailing slash). Used for OAuth redirects.
APP_URL=https://your-worker.example.workers.dev

# Comma-separated admin allowlists (at least one recommended).
ADMIN_EMAILS=hf@bighappysmiley.com
ADMIN_GITHUB_LOGINS=

# GitHub OAuth App
# Authorization callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# BigHappySmiley OAuth (generic OIDC/OAuth2)
# Authorization callback URL: ${APP_URL}/api/auth/bhs/callback
BHS_OAUTH_CLIENT_ID=
BHS_OAUTH_CLIENT_SECRET=
BHS_OAUTH_AUTHORIZE_URL=
BHS_OAUTH_TOKEN_URL=
BHS_OAUTH_USERINFO_URL=
BHS_OAUTH_SCOPE=openid profile email

# Neon Auth (email login — Managed Better Auth)
# Provisioned via Neon MCP / Console → Auth
NEON_AUTH_BASE_URL=https://ep-holy-resonance-b4yv6szs.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
